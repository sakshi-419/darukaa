# Darukaa.Earth — AI Biodiversity Intelligence System Environment Config

# LLM Provider Configuration
LLM_PROVIDER=mock  # Options: mock, openai, gemini
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Qdrant with automatic ChromaDB fallback)
VECTOR_DB_TYPE=chroma  # Options: chroma, qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Relational Database
DATABASE_URL=sqlite:///./darukaa.db

# Optional APIs
OPTIONAL_WEATHER_API_KEY=
DEBUG=True
